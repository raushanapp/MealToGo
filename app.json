{
  "name": "MealToGo",
  "displayName": "MealToGo",
  "version": "0.0.1",
  "orientation": "portrait",
  "splash": {
    "image": "./assets/splash.png",
    "resizeMode": "cover",
    "backgroundColor": "#FFF4E3"
  },
  "updates": {
    "fallbackToCacheTimeout": 0
  },
  "assetBundlePatterns": ["**/*"],
